{
  "name": "telegram-first-multistore-commerce",
  "version": "1.0.0",
  "description": "A production-ready multilingual multistore commerce platform powered by Telegram, supporting TON and manual payments, digital and physical products, referrals, affiliates, commissions, automated fulfillment, analytics, SEO, and Railway deployment.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "env:check": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.667.0",
    "@aws-sdk/s3-request-presigner": "^3.667.0",
    "@hono/node-server": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.6.10",
    "jose": "^5.9.6",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
