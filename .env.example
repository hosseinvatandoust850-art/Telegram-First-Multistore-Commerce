# =============================================================================
# Telegram-First Multistore Commerce — Environment Variables
# =============================================================================
# Copy this file to `.env` for local development. On Railway, set these in the
# service Variables (do NOT commit a real .env).
#
# Every variable below is documented as [REQUIRED] or [OPTIONAL].
# Only configure variables for features you actually use.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# [REQUIRED] Port the HTTP server listens on. Railway sets PORT automatically.
PORT=8080

# [REQUIRED] Public URL of this application (no trailing slash).
# Examples:
#   - Railway default domain:  https://<service>.up.railway.app
#   - Custom domain:           https://commercestore.example.com
# When omitted, the app auto-derives it from RAILWAY_PUBLIC_DOMAIN / RAILWAY_STATIC_URL.
APP_URL=https://your-app.up.railway.app

# [OPTIONAL] Runtime environment: development | test | production.
# In production, demo/seed data is NEVER auto-created.
NODE_ENV=production

# [REQUIRED] Use a long, random string. Signs JWT session/bot auth tokens.
APP_SECRET=change-me-to-a-long-random-string

# [OPTIONAL] Comma-separated list of additional bot admin telegram IDs (super admins).
SUPER_ADMIN_TELEGRAM_IDS=

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# [REQUIRED] Connection string. On Railway, use the postgres service reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# or paste the internal connection string (DATABASE_URL) from the Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commerce?schema=public

# [OPTIONAL] Max concurrent DB pool connections.
DATABASE_POOL_MAX=10

# [OPTIONAL] Prisma direct URL (Railway uses a pooled/internal connection).
DIRECT_URL=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# [REQUIRED] Salt/secret used to sign Telegram-issued tokens (if enabled).
# [OPTIONAL] Secrets required only for the features you enable. Minimum is APP_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# How long (seconds) a JWT session stays valid.
SESSION_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# TELEGRAM
# -----------------------------------------------------------------------------
# [OPTIONAL] The master bot token. If each store supplies its own token in the
# dashboard (recommended for multiple stores), you may leave this empty.
# Create a bot with @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=

# [OPTIONAL] The username of the master bot (without @).
TELEGRAM_BOT_USERNAME=

# [REQUIRED for production webhooks] Force HTTPS webhook URLs (must be true).
TELEGRAM_WEBHOOK_HTTPS=true

# [OPTIONAL] Webhook secret to validate incoming updates (recommended).
TELEGRAM_WEBHOOK_SECRET_NAME=telegram-secret

# -----------------------------------------------------------------------------
# TON / PAYMENTS
# -----------------------------------------------------------------------------
# [OPTIONAL] TON blockchain network: mainnet | testnet.
TON_NETWORK=mainnet

# [OPTIONAL] TON API provider. Supported: toncenter | tonapi.
TON_PROVIDER=toncenter

# [OPTIONAL] TON API base URL (overrides provider default).
TON_API_URL=https://toncenter.com/api/v2

# [OPTIONAL] TON API key / token (required for toncenter/tonapi in production).
TON_API_KEY=

# [OPTIONAL] Default receiving TON address used to generate invoices. A store can
# override this in the dashboard.
TON_PAYMENT_ADDRESS=UQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAJKZ

# [OPTIONAL] Allows a store to accept payments on testnet during setup. NEVER true in production.
PAYMENT_ALLOW_TESTNET=false

# [OPTIONAL] Enables development-mode mock payments. ALWAYS false in production.
PAYMENT_DEV_MODE=false

# [OPTIONAL] How often (ms) the worker polls for on-chain TON payments.
TON_POLL_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# FILE / OBJECT STORAGE
# -----------------------------------------------------------------------------
# The app supports S3-compatible object storage (recommended for production) and
# a fallback local volume. Configure S3, or point STORAGE_DIR at a Railway volume.
# [OPTIONAL] S3 endpoint (e.g. https://<account>.r2.cloudflarestorage.com).
S3_ENDPOINT=

# [OPTIONAL] S3 bucket name.
S3_BUCKET=

# [OPTIONAL] S3 region (default us-east-1).
S3_REGION=us-east-1

# [REQUIRED when using S3] Access key.
S3_ACCESS_KEY_ID=

# [REQUIRED when using S3] Secret access key.
S3_SECRET_ACCESS_KEY=

# [OPTIONAL] Force path-style addressing (true for MinIO/R2).
S3_FORCE_PATH_STYLE=true

# [REQUIRED with local storage] Public base URL for uploaded files.
# On Railway, mount a volume and keep this pointing at storage.
STORAGE_URL=/storage

# [REQUIRED with local storage] Absolute path under which uploads are stored.
# Mount a Railway volume here (e.g. /data/storage).
STORAGE_DIR=/app/storage

# [REQUIRED] Max upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# -----------------------------------------------------------------------------
# BACKGROUND JOBS / SCHEDULER
# -----------------------------------------------------------------------------
# [OPTIONAL] Runs the in-process scheduler inside the web service.
# Set true for a single-service deployment, or false and run `npm run start:worker`
# as a separate Railway service.
ENABLE_INLINE_WORKER=true

# [OPTIONAL] Cron schedule for automatic database backups (pg_dump).
BACKUP_CRON=0 3 * * *

# [OPTIONAL] Cron schedule for TON payment polling (overrides interval if set).
TON_POLL_CRON=

# [OPTIONAL] Enables automatic backups. Requires pg_dump in the image.
ENABLE_BACKUPS=true

# [OPTIONAL] Upload backups to S3-compatible storage instead of local volume.
BACKUP_S3=false

# [OPTIONAL] Retention: keep the last N backups.
BACKUP_RETENTION=7

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------
# [OPTIONAL] Comma-separated allowed email domains for store owner registration.
ALLOWED_EMAIL_DOMAINS=

# [OPTIONAL] Default locale/language applied to new stores.
DEFAULT_LOCALE=en

# [OPTIONAL] Currency conversion API / fx rate source (unused if single currency).
FX_API_KEY=

# [OPTIONAL] Mail/SMTP to send order notifications. Leave empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# [OPTIONAL] Optional analytics/telemetry (leave empty to disable).
SENTRY_DSN=
